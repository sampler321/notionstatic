---
// Database views other than gallery: table, list, board. Same toolbar as the gallery (the client
// script sorts/filters/searches any .ns-card children of the view body).
import { load, plain, hrefFor } from "../lib/data.mjs";
import { richText, esc, pillStyle } from "../lib/richtext.mjs";
import Icon from "./Icon.astro";

const { block } = Astro.props;
const { tables, blocks, viewRows } = load();
const viewId = (block.view_ids || [])[0];
const view = tables.collection_view?.[viewId] || {};
const type = view.type || "table";
const collection = tables.collection?.[view.format?.collection_pointer?.id || block.collection_id] || {};
const schema = collection.schema || {};
const rows = (viewRows[viewId] || []).map((id) => blocks[id]).filter((r) => r && r.alive !== false);
const name = plain(collection.name) || plain(block.properties?.title) || "Untitled";
const linked = collection.parent_id && collection.parent_id !== block.id;
const query = view.query2 || view.query || {};
const sorts = (query.sort || []).filter((s) => schema[s.property]);
const hasFilter = !!(query.filter?.filters?.length);
// (kept as two statements for the Astro 7 compiler)
const PROPS_KEYS = { table: "table_properties", list: "list_properties", board: "board_properties" };
const propsKey = PROPS_KEYS[type] || "table_properties";
const cols = (view.format?.[propsKey] || Object.keys(schema).map((property) => ({ property, visible: true })))
  .filter((p) => p.visible !== false && schema[p.property]);
if (schema.title && !cols.some((c) => c.property === "title")) cols.unshift({ property: "title", visible: true, width: 276 });
const clientSchema = Object.fromEntries(Object.entries(schema).map(([k, s]) => [k, { name: s.name, type: s.type, options: (s.options || []).map((o) => ({ value: o.value, color: o.color })) }]));
const rowData = (row) => JSON.stringify(Object.fromEntries(Object.keys(schema).map((k) => [k, plain(row.properties?.[k])])));
// (no nested template strings here: the Astro 7 compiler cannot parse them in frontmatter)
const pillHtml = (s, x) => '<span class="ns-pill" style="' + pillStyle((s.options || []).find((o) => o.value === x)?.color) + '">' + esc(x) + "</span>";
const linkHtml = (href, label) => '<a class="ns-link" href="' + esc(href) + '" target="_blank" rel="noopener"><span class="ns-link-u">' + esc(label) + "</span></a>";
const cell = (row, key) => {
  const s = schema[key], v = row.properties?.[key];
  if (!s) return "";
  if (s.type === "checkbox") return '<span class="ns-checkbox' + (plain(v) === "Yes" ? " is-on" : "") + '"></span>';
  if (!v) return "";
  if (s.type === "select" || s.type === "multi_select" || s.type === "status") return '<span class="ns-pills">' + plain(v).split(",").map((x) => x.trim()).filter(Boolean).map((x) => pillHtml(s, x)).join("") + "</span>";
  if (s.type === "url") return linkHtml(plain(v), plain(v));
  if (s.type === "email") return linkHtml("mailto:" + plain(v), plain(v));
  return richText(v);
};
// Board: groups by the view's group-by property (select / status), in option order.
const groupBy = view.format?.board_columns_by?.property || view.format?.board_groups2?.property || Object.keys(schema).find((k) => schema[k].type === "select" || schema[k].type === "status");
const groups = type === "board" && groupBy ? [{ value: "", label: `No ${schema[groupBy]?.name || "value"}` }, ...(schema[groupBy]?.options || []).map((o) => ({ value: o.value, label: o.value, color: o.color }))]
  .map((g) => ({ ...g, rows: rows.filter((r) => (plain(r.properties?.[groupBy]) || "") === g.value) })).filter((g) => g.rows.length || g.value) : [];
const titleCell = (row) => `${richText(row.properties?.title) || "Untitled"}`;
---
<div class="ns-gallery-head" data-ns-db>
  <a class="ns-gallery-title" href={hrefFor(collection.parent_id) || undefined}>
    {linked && <svg class="ns-linked-arrow" viewBox="0 0 20 20" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M15.575 5.05a.625.625 0 0 0-.625-.625H7.313a.625.625 0 1 0 0 1.25h6.128L4.596 14.52a.617.617 0 0 0 .012.872c.244.244.635.25.872.012l8.845-8.845v6.128a.625.625 0 1 0 1.25 0z"/></svg>}
    <span>{name}</span>
  </a>
  <div class="ns-db-tools">
    <button type="button" class="ns-db-btn" data-db="minimize" aria-label="Minimize" hidden><svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M3.4 3.6a.6.6 0 0 1 .85 0l4 4a.6.6 0 0 1 0 .85l-4 4a.6.6 0 1 1-.85-.85L6.98 8 3.4 4.45a.6.6 0 0 1 0-.85m4.3 0a.6.6 0 0 1 .85 0l4 4a.6.6 0 0 1 0 .85l-4 4a.6.6 0 1 1-.85-.85L11.28 8 7.7 4.45a.6.6 0 0 1 0-.85"/></svg></button>
    <button type="button" class:list={["ns-db-btn", { "is-on": hasFilter }]} data-db="filter" aria-label="Filter"><svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M2.4 3.7a.7.7 0 1 0 0 1.4h11.2a.7.7 0 1 0 0-1.4zm9.5 3.594H4.1a.7.7 0 1 0 0 1.4h7.8a.7.7 0 1 0 0-1.4M5.8 10.9a.7.7 0 1 0 0 1.4h4.4a.7.7 0 1 0 0-1.4z"/></svg></button>
    <button type="button" class:list={["ns-db-btn", { "is-on": sorts.length > 0 }]} data-db="sort" aria-label="Sort"><svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M11.348 2.672a.625.625 0 0 0-.884 0L7.666 5.471a.625.625 0 1 0 .884.883l1.731-1.73v8.262a.625.625 0 1 0 1.25 0V4.623l1.732 1.731a.625.625 0 0 0 .884-.883zM5.093 2.49a.625.625 0 0 0-.625.624v8.263L2.737 9.646a.625.625 0 1 0-.884.883l2.798 2.799a.625.625 0 0 0 .884 0l2.799-2.799a.625.625 0 1 0-.884-.883l-1.732 1.73V3.115a.625.625 0 0 0-.625-.625"/></svg></button>
    <div class="ns-db-search">
      <button type="button" class="ns-db-btn" data-db="search" aria-label="Search"><svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M7.1 1.975a5.125 5.125 0 1 0 3.155 9.164l3.107 3.107a.625.625 0 1 0 .884-.884l-3.107-3.107A5.125 5.125 0 0 0 7.1 1.975M3.225 7.1a3.875 3.875 0 1 1 7.75 0 3.875 3.875 0 0 1-7.75 0"/></svg></button>
      <input type="search" placeholder="Type to search…" aria-label="Search this database" hidden />
    </div>
  </div>
</div>
<div class="ns-db-bar" hidden>
  {sorts.length > 0 && <button type="button" class="ns-db-chip is-blue" data-db="sorts"><span data-db-sortcount>{sorts.length} {sorts.length === 1 ? "sort" : "sorts"}</span> ▾</button>}
  {sorts.length > 0 && <span class="ns-db-sep" />}
  <span class="ns-db-filters"></span>
  <button type="button" class="ns-db-chip" data-db="addfilter">+ Filter</button>
</div>
<script type="application/json" class="ns-db-data" set:html={JSON.stringify({ schema: clientSchema, sorts }).replace(/</g, "\\u003c")} />

{type === "table" && (
  <div class="ns-table-view">
    <div class="ns-tv-head">
      {cols.map((c) => <div class="ns-tv-cell ns-tv-th" style={`width:${c.width || (c.property === "title" ? 276 : 200)}px`}><span class={`ns-prop-icon ns-prop-${schema[c.property].type}`} aria-hidden="true" />{schema[c.property].name}</div>)}
    </div>
    <div class="ns-tv-body">
      {rows.map((row, i) => (
        <div class="ns-card ns-tv-row" data-block-id={row.id} data-row={rowData(row)} data-order={i}>
          {cols.map((c) => c.property === "title"
            ? <a class="ns-tv-cell ns-tv-title" href={hrefFor(row.id) || undefined} style={`width:${c.width || 276}px`}><Icon icon={row.format?.page_icon} blockId={row.id} size={16} box={20} fallback="page" /><span set:html={titleCell(row)} /></a>
            : <div class="ns-tv-cell" style={`width:${c.width || 200}px`} set:html={cell(row, c.property)} />)}
        </div>
      ))}
    </div>
  </div>
)}

{type === "list" && (
  <div class="ns-list-view">
    {rows.map((row, i) => (
      <a class="ns-card ns-lv-row" data-block-id={row.id} data-row={rowData(row)} data-order={i} href={hrefFor(row.id) || undefined}>
        <Icon icon={row.format?.page_icon} blockId={row.id} size={18} box={22} fallback="page" />
        <span class="ns-lv-title" set:html={titleCell(row)} />
        <span class="ns-lv-props">{cols.filter((c) => c.property !== "title").map((c) => <span class="ns-lv-prop" set:html={cell(row, c.property)} />)}</span>
      </a>
    ))}
  </div>
)}

{type === "board" && (
  <div class="ns-board-view">
    {groups.map((g) => (
      <div class="ns-bv-col">
        <div class="ns-bv-head">{g.value ? <span class="ns-pill" style={pillStyle(g.color)}>{g.label}</span> : <span class="ns-bv-none">{g.label}</span>}<span class="ns-bv-count">{g.rows.length}</span></div>
        <div class="ns-bv-cards">
          {g.rows.map((row) => (
            <a class="ns-card ns-bv-card" data-block-id={row.id} data-row={rowData(row)} data-order={rows.indexOf(row)} href={hrefFor(row.id) || undefined}>
              <div class="ns-card-title"><Icon icon={row.format?.page_icon} blockId={row.id} size={16} box={20} fallback="page" /><div class="ns-card-name" set:html={titleCell(row)} /></div>
              {cols.filter((c) => c.property !== "title" && c.property !== groupBy && row.properties?.[c.property]).map((c) => <div class="ns-card-prop" set:html={cell(row, c.property)} />)}
            </a>
          ))}
        </div>
      </div>
    ))}
  </div>
)}

{!["table", "list", "board"].includes(type) && (
  <div class="ns-list-view">
    {rows.map((row, i) => (
      <a class="ns-card ns-lv-row" data-block-id={row.id} data-row={rowData(row)} data-order={i} href={hrefFor(row.id) || undefined}>
        <Icon icon={row.format?.page_icon} blockId={row.id} size={18} box={22} fallback="page" /><span class="ns-lv-title" set:html={titleCell(row)} />
      </a>
    ))}
  </div>
)}

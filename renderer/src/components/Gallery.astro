---
// Database gallery view, rendered from the recorded view settings and Notion's own row order.
// Toolbar (filter / sort / search) works client-side like on notion.site: changes only affect
// the visitor's view. Each card carries its property values for that (data-row).
import { load, plain, hrefFor } from "../lib/data.mjs";
import { richText, esc, pillStyle } from "../lib/richtext.mjs";
import Icon from "./Icon.astro";

interface Props { block: any }
const { block } = Astro.props;
const { tables, blocks, viewRows, image } = load();
const viewId = (block.view_ids || [])[0];
const view = tables.collection_view?.[viewId] || {};
const collection = tables.collection?.[view.format?.collection_pointer?.id || block.collection_id] || {};
const schema = collection.schema || {};
const rows = (viewRows[viewId] || []).map((id) => blocks[id]).filter((r) => r && r.alive !== false);
const visible = (view.format?.gallery_properties || []).filter((p) => p.visible);
const coverSize = view.format?.gallery_cover_size || "medium";
const linked = collection.parent_id && collection.parent_id !== block.id; // a linked view shows ↗
const name = plain(collection.name) || "Untitled";
const query = view.query2 || view.query || {};
const sorts = (query.sort || []).filter((s) => schema[s.property]);
const hasFilter = !!(query.filter?.filters?.length);

// Cover: first image in the page ("page_content"), like Notion.
const cover = (row) => {
  if (view.format?.gallery_cover?.type !== "page_content") return null;
  const find = (ids) => { for (const id of ids || []) { const b = blocks[id]; if (!b || b.alive === false) continue; if (b.type === "image") return image(b.properties?.source?.[0]?.[0], b.id); const deeper = ["column_list", "column"].includes(b.type) && find(b.content); if (deeper) return deeper; } return null; };
  return find(row.content);
};
const pill = (prop, value) => `<span class="ns-pill" style="${pillStyle((schema[prop]?.options || []).find((o) => o.value === value)?.color)}">${esc(value)}</span>`;
// What the client needs to sort/filter: property names, types, option order/colours.
const clientSchema = Object.fromEntries(Object.entries(schema).map(([k, s]) => [k, { name: s.name, type: s.type, options: (s.options || []).map((o) => ({ value: o.value, color: o.color })) }]));
const rowData = (row) => JSON.stringify(Object.fromEntries(Object.keys(schema).map((k) => [k, plain(row.properties?.[k])])));
const SORT_ICON = '<path fill="currentColor" d="M11.348 2.672a.625.625 0 0 0-.884 0L7.666 5.471a.625.625 0 1 0 .884.883l1.731-1.73v8.262a.625.625 0 1 0 1.25 0V4.623l1.732 1.731a.625.625 0 0 0 .884-.883zM5.093 2.49a.625.625 0 0 0-.625.624v8.263L2.737 9.646a.625.625 0 1 0-.884.883l2.798 2.799a.625.625 0 0 0 .884 0l2.799-2.799a.625.625 0 1 0-.884-.883l-1.732 1.73V3.115a.625.625 0 0 0-.625-.625"/>';
---
<div class="ns-gallery-head" data-ns-db>
  <a class="ns-gallery-title" href={hrefFor(collection.parent_id) || undefined}>
    {linked && <svg class="ns-linked-arrow" viewBox="0 0 20 20" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M15.575 5.05a.625.625 0 0 0-.625-.625H7.313a.625.625 0 1 0 0 1.25h6.128L4.596 14.52a.617.617 0 0 0 .012.872c.244.244.635.25.872.012l8.845-8.845v6.128a.625.625 0 1 0 1.25 0z"/></svg>}
    <span>{name}</span>
  </a>
  <div class="ns-db-tools">
    <button type="button" class="ns-db-btn" data-db="minimize" aria-label="Minimize" hidden><svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M3.4 3.6a.6.6 0 0 1 .85 0l4 4a.6.6 0 0 1 0 .85l-4 4a.6.6 0 1 1-.85-.85L6.98 8 3.4 4.45a.6.6 0 0 1 0-.85m4.3 0a.6.6 0 0 1 .85 0l4 4a.6.6 0 0 1 0 .85l-4 4a.6.6 0 1 1-.85-.85L11.28 8 7.7 4.45a.6.6 0 0 1 0-.85"/></svg></button>
    <button type="button" class:list={["ns-db-btn", { "is-on": hasFilter }]} data-db="filter" aria-label="Filter"><svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M2.4 3.7a.7.7 0 1 0 0 1.4h11.2a.7.7 0 1 0 0-1.4zm9.5 3.594H4.1a.7.7 0 1 0 0 1.4h7.8a.7.7 0 1 0 0-1.4M5.8 10.9a.7.7 0 1 0 0 1.4h4.4a.7.7 0 1 0 0-1.4z"/></svg></button>
    <button type="button" class:list={["ns-db-btn", { "is-on": sorts.length > 0 }]} data-db="sort" aria-label="Sort"><svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" set:html={SORT_ICON} /></button>
    <div class="ns-db-search">
      <button type="button" class="ns-db-btn" data-db="search" aria-label="Search"><svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M7.1 1.975a5.125 5.125 0 1 0 3.155 9.164l3.107 3.107a.625.625 0 1 0 .884-.884l-3.107-3.107A5.125 5.125 0 0 0 7.1 1.975M3.225 7.1a3.875 3.875 0 1 1 7.75 0 3.875 3.875 0 0 1-7.75 0"/></svg></button>
      <input type="search" placeholder="Type to search…" aria-label="Search this database" hidden />
    </div>
  </div>
</div>
<div class="ns-db-bar" hidden>
  {sorts.length > 0 && <button type="button" class="ns-db-chip is-blue" data-db="sorts"><svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" set:html={SORT_ICON} /><span data-db-sortcount>{sorts.length} {sorts.length === 1 ? "sort" : "sorts"}</span><svg viewBox="0 0 16 16" width="10" height="10" aria-hidden="true"><path d="M4 6l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></button>}
  {sorts.length > 0 && <span class="ns-db-sep" />}
  <span class="ns-db-filters"></span>
  <button type="button" class="ns-db-chip" data-db="addfilter"><svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true"><path d="M8 3v10M3 8h10" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>Filter</button>
</div>
<script type="application/json" class="ns-db-data" set:html={JSON.stringify({ schema: clientSchema, sorts }).replace(/</g, "\\u003c")} />
<div class={`ns-gallery ns-gallery-${coverSize}`}>
  {rows.map((row, i) => {
    const href = hrefFor(row.id);
    const img = cover(row);
    return (
      <div class="ns-card" data-block-id={row.id} data-row={rowData(row)} data-order={i}>
        <a href={href || "#"}>
          {view.format?.gallery_cover?.type && <div class="ns-card-cover">{img && <img src={img} alt="" loading="lazy" decoding="async" />}</div>}
          {visible.map((p) => {
            const v = row.properties?.[p.property];
            if (p.property === "title") return <div class="ns-card-title"><Icon icon={row.format?.page_icon} blockId={row.id} size={18} box={24} fallback="page" /><div class="ns-card-name" set:html={richText(v) || "Untitled"} /></div>;
            if (!v) return null;
            const type = schema[p.property]?.type;
            if (type === "multi_select" || type === "select") return <div class="ns-card-prop"><div class="ns-pills" set:html={plain(v).split(",").map((x) => x.trim()).filter(Boolean).map((x) => pill(p.property, x)).join("")} /></div>;
            if (type === "checkbox") return null;
            return <div class="ns-card-prop"><div class="ns-card-text" set:html={richText(v)} /></div>;
          })}
          <div class="ns-card-end" />
        </a>
        <button type="button" class="ns-card-more" aria-label="More" data-card-menu={href}><svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M3.2 6.725a1.275 1.275 0 1 0 0 2.55 1.275 1.275 0 0 0 0-2.55m4.8 0a1.275 1.275 0 1 0 0 2.55 1.275 1.275 0 0 0 0-2.55m4.8 0a1.275 1.275 0 1 0 0 2.55 1.275 1.275 0 0 0 0-2.55"/></svg></button>
      </div>
    );
  })}
</div>
